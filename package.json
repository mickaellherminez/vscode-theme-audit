{
  "name": "vscode-theme-audit",
  "version": "0.2.0",
  "description": "Accessibility audit for VS Code color themes: WCAG contrast and color blindness simulations, for theme authors and CI.",
  "keywords": [
    "vscode",
    "vscodium",
    "open-vsx",
    "theme",
    "color-theme",
    "vscode-theme",
    "accessibility",
    "a11y",
    "wcag",
    "contrast",
    "color-blindness",
    "colorblind",
    "cli",
    "ci"
  ],
  "license": "MIT",
  "author": "Mickaël Lherminez (https://mickaellherminez.net)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mickaellherminez/vscode-theme-audit.git"
  },
  "bugs": {
    "url": "https://github.com/mickaellherminez/vscode-theme-audit/issues"
  },
  "homepage": "https://github.com/mickaellherminez/vscode-theme-audit#readme",
  "type": "module",
  "bin": {
    "vscode-theme-audit": "dist/cli.js"
  },
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"test/*.test.ts\"",
    "corpus": "node scripts/corpus.ts",
    "test:corpus": "node scripts/corpus.ts && node --test \"test/corpus/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && node --test \"test/package/*.test.ts\" && npm run check:action && npm run test:action",
    "test:package": "npm run build && node --test \"test/package/*.test.ts\"",
    "build:action": "node scripts/action.ts",
    "check:action": "node scripts/action.ts --check",
    "test:action": "node --test \"test/action-package/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/yauzl": "^3.4.0",
    "ajv": "^8.20.0",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "yauzl": "^3.4.0"
  }
}
